<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
                Title="ПР8 — Виртуальные методы" Height="550" Width="1300"
    MinHeight="550" MinWidth="1300">
    <Grid Background="#FF424242">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" Margin="10"
                BorderBrush="Black" BorderThickness="1" CornerRadius="5">
            <StackPanel Margin="15">
                <Label Content="Боец (обычные доспехи)"
                       FontWeight="Bold" FontSize="16"
                       HorizontalAlignment="Center"/>
                <Label x:Name="lblBasicHealth"
                       Content="Здоровье: 100 / 100"
                       FontSize="14" HorizontalAlignment="Center"/>
                <Image Height="149" Source="/ggg.png" Stretch="Fill" Width="276"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="White" Margin="10"
                BorderBrush="Black" BorderThickness="1" CornerRadius="5">
            <StackPanel Margin="15">
                <Label Content="Боец в лёгких доспехах"
                       FontWeight="Bold" FontSize="16"
                       HorizontalAlignment="Center"/>
                <Label x:Name="lblLightHealth"
                       Content="Здоровье: 100 / 100"
                       FontSize="14" HorizontalAlignment="Center"/>
                <Image Height="147" Source="/ggg.png" Stretch="Fill" Width="272"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="White" Margin="10"
                BorderBrush="Black" BorderThickness="1" CornerRadius="5">
            <StackPanel Margin="15">
                <Label Content="Боец в тяжёлых доспехах"
                       FontWeight="Bold" FontSize="16"
                       HorizontalAlignment="Center"/>
                <Label x:Name="lblHeavyHealth"
                       Content="Здоровье: 100 / 100"
                       FontSize="14" HorizontalAlignment="Center"/>
                <Image Height="145" Source="/ggg.png" Stretch="Fill" Width="280"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="3" Background="White" Margin="10"
                BorderBrush="Black" BorderThickness="1" CornerRadius="5">
            <StackPanel Margin="15">
                <Image Height="210" Source="/images.jpg" Stretch="Fill" Width="156"/>
                <Label x:Name="lblEnemyName" Content="Противник"
                       FontWeight="Bold" FontSize="16"
                       HorizontalAlignment="Center"/>
                <Label x:Name="lblEnemyDamage" Content="Урон: 20"
                       FontSize="14" HorizontalAlignment="Center"/>
                <Button Content="Атаковать всех воинов"
                        Click="BtnAttack_Click"
                        Height="35" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>